#!/usr/bin/env bash

echo "Starting main script..."
echo "TTT - $(date)"

#
# Start Jupyter server
#

# Clean the environment
module purge

# Set working directory to notebook root directory
cd "${NOTEBOOK_ROOT}"

# Setup Jupyter environment
module load project/ondemand app_jupyter/<%= context.jupyter_version %>
LMOD_EXACT_MATCH=no module load vllm

VLLM_MODEL=<%=
    # /fs/ess/pub_data/vllm/.cache/huggingface/hub/models--meta-llama--Llama-3.2-3B
    split = context.vllm_model.split("/")

    # models--meta-llama--Llama-3.2-3B
    tail = split[-1]

    # get rid of the "models" at the beginning of models--meta-llama--Llama-3.2-3B
    model_name_arr = tail.split("--")
    model_name = model_name_arr[1..].join("/")

    model_name
%>
export HF_HOME=<%=
    # /fs/ess/pub_data/vllm/.cache/huggingface/hub/models--meta-llama--Llama-3.2-3B
    split = context.vllm_model.split("/")

    # /fs/ess/pub_data/vllm/.cache/huggingface/hub
    head =  split[0..-2]

    # chop off the "hub" at the end of /fs/ess/pub_data/vllm/.cache/huggingface/hub
    hf_home_arr = head[0..-2]
    hf_home = hf_home_arr.join("/")

    hf_home
%>

echo $VLLM_MODEL
echo $HF_HOME

source vllm_start_helper "$VLLM_MODEL"

module list
export JUPYTER_PATH="${PWD}/share/jupyter:${OSC_LLM_API_PATH}"

echo "TTT - $(date)"

# List available kernels for debugging purposes
set -x
jupyter kernelspec list
{ set +x; } 2>/dev/null
echo "TTT - $(date)"

# Launch the Jupyter server
set -x
jupyter <%= context.mode == "1" ? 'lab' : 'notebook' %> --config="${CONFIG_FILE}"
